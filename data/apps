# fluxland per-window settings: the Fluxbox apps file
# Format: [app] (pattern) ... settings ... [end]; see fluxland-apps(5).
# A Fluxbox ~/.fluxbox/apps works as it is.
#
# Patterns (anchored POSIX extended regexes, all terms must match):
#   (name=...)   X11 WM_CLASS instance; Wayland app_id
#   (class=...)  X11 WM_CLASS class; Wayland app_id
#   (title=...)  window title; also role, tag, transient, workspace...
#   (xterm)      a bare word matches the name
#   (class!=firefox) negates; {N} after the pattern: at most N windows
#
# [app] entries match main windows, [transient] entries dialogs.
# The first entry that matches a window wins.
#
# Settings:
#   [Workspace]      {N}          - open on workspace N (0-based)
#   [Jump]           {yes|no}     - and switch to it
#   [Head]           {N}          - open on monitor N (1-based)
#   [Dimensions]     {W H}        - size with decorations, pixels or % of the head
#   [Position]       (Corner) {X Y} - from a corner: TopLeft, Top, TopRight,
#                                   Left, Center, Right, BottomLeft, Bottom,
#                                   BottomRight; pixels or %
#   [Deco]           {preset}     - NORMAL, NONE, BORDER, TAB, TINY, TOOL
#   [Layer]          {name|N}     - Top (6), Normal (8), Bottom (10), Desktop (12)
#   [Alpha]          {focus unfocus} - transparency (0-255)
#   [Sticky] [Shaded] [Minimized] [Fullscreen] {yes|no}
#   [Maximized]      {yes|horz|vert|no}
#   [Hidden] [FocusHidden] [IconHidden] {yes|no} - skip iconbar/cycling
#   [FocusNewWindow] {yes|no}     - focus when opened
#   [FocusProtection] {Gain|Refuse|Deny|Lock|None, ...}
#   [Close]          {yes|no}     - save the window's state when it closes
#
# Tab groups:
#   [group] (workspace)   <- optional: join a window on this workspace
#     [app] (class=pattern1)
#     [app] (class=pattern2)
#     [Layer] {Bottom}    <- optional settings for the whole group
#   [end]
#
# [startup] {command} runs a command when fluxland starts.

# -------------------------------------------------------------------
# Web browsers: open on workspace 2, maximized
# -------------------------------------------------------------------

[app] (class=firefox)
  [Workspace] {1}
  [Maximized] {yes}
  [FocusNewWindow] {yes}
[end]

[app] (class=chromium-browser)
  [Workspace] {1}
  [Maximized] {yes}
[end]

[app] (class=google-chrome)
  [Workspace] {1}
  [Maximized] {yes}
[end]

# -------------------------------------------------------------------
# Terminal emulators: specific size, centered
# -------------------------------------------------------------------

[app] (class=foot)
  [Dimensions] {800 600}
  [Position] (Center) {0 0}
[end]

[app] (class=Alacritty)
  [Dimensions] {800 600}
  [Position] (Center) {0 0}
[end]

[app] (class=kitty)
  [Dimensions] {800 600}
  [Position] (Center) {0 0}
[end]

# -------------------------------------------------------------------
# File managers: centered
# -------------------------------------------------------------------

[app] (class=thunar)
  [Dimensions] {900 600}
  [Position] (Center) {0 0}
[end]

[app] (class=org.gnome.Nautilus)
  [Dimensions] {900 600}
  [Position] (Center) {0 0}
[end]

# -------------------------------------------------------------------
# Media players: above layer, specific size, borderless
# -------------------------------------------------------------------

[app] (class=mpv)
  [Dimensions] {960 540}
  [Position] (Center) {0 0}
  [Deco] {NONE}
  [Layer] {Above}
[end]

[app] (class=vlc)
  [Dimensions] {960 540}
  [Position] (Center) {0 0}
[end]

# -------------------------------------------------------------------
# Image viewers
# -------------------------------------------------------------------

[app] (class=imv)
  [Position] (Center) {0 0}
  [Deco] {BORDER}
[end]

# -------------------------------------------------------------------
# Text editors: workspace 3
# -------------------------------------------------------------------

[app] (class=code)
  [Workspace] {2}
  [Maximized] {yes}
[end]

# -------------------------------------------------------------------
# System monitors: small, top-right, semi-transparent
# -------------------------------------------------------------------

[app] (class=htop)
  [Dimensions] {700 500}
  [Position] (UpperRight) {0 0}
  [Alpha] {240 180}
[end]

# -------------------------------------------------------------------
# Dialog windows: centered, tool decoration
# -------------------------------------------------------------------

# Zenity / yad dialogs
[app] (class=zenity)
  [Position] (Center) {0 0}
  [Deco] {TOOL}
  [FocusNewWindow] {yes}
[end]

# -------------------------------------------------------------------
# Sticky applications (visible on all workspaces)
# -------------------------------------------------------------------

# System tray / notification area
[app] (class=waybar)
  [Sticky] {yes}
  [Deco] {NONE}
[end]

# -------------------------------------------------------------------
# Splash screens: no decoration, centered
# -------------------------------------------------------------------

[app] (title=.*[Ss]plash.*)
  [Deco] {NONE}
  [Position] (Center) {0 0}
  [FocusNewWindow] {no}
[end]

# -------------------------------------------------------------------
# Layer and decoration examples
# -------------------------------------------------------------------

# Desktop widgets: below normal windows, border-only decoration
# [app] (class=conky)
#   [Layer] {Below}
#   [Deco] {BORDER}
#   [Sticky] {yes}
# [end]

# Panels / docks: above normal windows, no decoration
# [app] (class=lxpanel)
#   [Layer] {Above}
#   [Deco] {NONE}
#   [Sticky] {yes}
# [end]

# Picture-in-picture: above layer, tiny decoration, small size
# [app] (title=.*Picture.in.Picture.*)
#   [Layer] {Above}
#   [Deco] {TINY}
#   [Dimensions] {480 270}
#   [Position] (LowerRight) {0 0}
#   [Sticky] {yes}
# [end]

# Start a window shaded (collapsed to title bar)
# [app] (class=xclock)
#   [Shaded] {yes}
# [end]

# -------------------------------------------------------------------
# Auto-grouping: tab terminal emulators together
# -------------------------------------------------------------------

# Group all terminals on the same workspace into tabs
[group] (workspace)
  [app] (class=foot)
  [app] (class=Alacritty)
  [app] (class=kitty)
  [app] (class=xterm)
[end]
