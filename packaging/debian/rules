#!/usr/bin/make -f
# Built from the release tarball (tools/dist.sh), which carries wlroots
# and the newer libraries in subprojects/: they are linked in statically
# and nothing of theirs is installed (--skip-subprojects).

include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
builddir = obj-$(DEB_HOST_GNU_TYPE)

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dxwayland=enabled -Dwerror=false

override_dh_auto_install:
	meson install -C $(builddir) --skip-subprojects \
		--destdir $(CURDIR)/debian/fluxland

# fluxland's unit tests (the integration ones start a compositor, which
# a build chroot can't)
override_dh_auto_test:
	meson test -C $(builddir) --suite fluxland --no-suite integration \
		--print-errorlogs
