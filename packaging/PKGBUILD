# Maintainer: Micheal Waltz <social.github@accounts.ecliptik.com>
#
# Built from the release tarball (tools/dist.sh): it carries wlroots 0.20
# and the libraries fluxland needs newer than a distribution may have,
# under subprojects/, and fluxland links them in statically.
pkgname=fluxland
pkgver=2.0.0
pkgrel=1
pkgdesc='A Wayland compositor that works the way Fluxbox does'
arch=('x86_64' 'aarch64')
url='https://github.com/ecliptik/fluxland'
license=('MIT')
depends=(
  'cairo'
  'gdk-pixbuf2'
  'lcms2'
  'libdisplay-info'
  'libdrm'
  'libinput'
  'libliftoff'
  'libxkbcommon'
  'mesa'
  'pango'
  'pixman'
  'seatd'
  'systemd-libs'
  'wayland'
  'xcb-util-errors'
  'xcb-util-renderutil'
  'xcb-util-wm'
)
makedepends=(
  'hwdata'
  'meson'
  'ninja'
  'wayland-protocols'
  'xorg-xwayland'
)
optdepends=(
  'xorg-xwayland: X11 programs'
  'foot: the default terminal'
  'xdg-desktop-portal-wlr: screen sharing and screenshots in programs'
  'xdg-desktop-portal-gtk: file chooser and other desktop portals'
  'grim: screenshots'
  'slurp: choosing a region'
  'wl-clipboard: clipboard on the command line'
  'swaylock: screen locker'
)
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP')

build() {
  # arch-meson turns every optional feature on, the bundled wlroots' too
  # (its Vulkan renderer...): let them find what's there instead
  arch-meson "$pkgname-$pkgver" build --auto-features=auto \
    -Dxwayland=enabled -Dwerror=false
  meson compile -C build
}

check() {
  # The unit tests (the integration ones start a compositor)
  meson test -C build --suite fluxland --no-suite integration --print-errorlogs
}

package() {
  # fluxland only: nothing of the bundled libraries is installed
  meson install -C build --skip-subprojects --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
